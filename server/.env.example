# Server
# Render sets PORT itself; locally it defaults to 5000.
PORT=5000
# development locally; set to production on Render.
NODE_ENV=development
# Your frontend URL(s): the only browser origins allowed to call the API and Socket.IO.
# Required in production, e.g. https://your-app.vercel.app (comma-separate several, no trailing path).
# Locally this can stay as is. (CLIENT_ORIGIN is the older name for this variable and still works.)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
# Remember to allow your IP under Network Access and include a database name.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/live-quiz?retryWrites=true&w=majority

# AI quiz generation (server-side only, never sent to the browser).
# Get a free key at https://aistudio.google.com/apikey . Leave blank to disable the feature.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (always the current Flash model).
# If that model is overloaded (503/504 errors), gemini-flash-lite-latest is faster and more available.
# Older versions such as gemini-2.5-flash are retired for new API keys.
GEMINI_MODEL=gemini-flash-latest
# Optional. If the main model is overloaded, over quota or times out, the server retries once on this
# model automatically. Defaults to gemini-flash-lite-latest; set to "off" to disable.
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Optional. Give up on one Gemini call after this many milliseconds (default 45000).
# GEMINI_TIMEOUT_MS=45000
# Max AI generations per host (rate limits to control cost)
AI_LIMIT_PER_HOUR=10
AI_LIMIT_PER_DAY=30

# Auth (use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
