# Backend URL, baked into the app at BUILD time (set it in Vercel's Environment Variables).
# Production: your Render service URL ending in /api
VITE_API_URL=https://your-service-name.onrender.com/api
# Local development: copy this file to .env and use
# VITE_API_URL=http://localhost:5000/api

# Optional. Socket.IO URL; defaults to the same host as VITE_API_URL, so you normally leave it out.
# VITE_SOCKET_URL=https://your-service-name.onrender.com
